        <property name="styleSheet">
         <string notr="true">/* 🔹 Dégradé de fond violet-bleu */
QWidget#loginPage {
    background-color: #000035;
}


/* 🔹 Effet &quot;verre fumé&quot; pour la boîte de connexion */
QFrame#loginFrame {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    padding: 20px;
}

/* 🔹 Style des champs de texte */
QLineEdit {
    background-color: rgba(255, 255, 255, 0.2);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 10px;
    padding: 10px;
    font-size: 14pt;
    color: white;
}

QLineEdit::placeholder {
    color: rgba(255, 255, 255, 0.6);
}

/* Effet lumineux lorsqu'on clique sur un champ */
QLineEdit:focus {
    border: 2px solid #FF007F;
    background-color: rgba(255, 255, 255, 0.3);
}


/* 🔹 Bouton LOGIN */
QPushButton#loginButton {
    background-color: #FF007F;  /* Rose vif */
    border-radius: 12px;
    font-size: 14pt;
    font-weight: bold;
    color: white;
    padding: 12px;
    min-width: 150px;
    border: none;
}

QPushButton#loginButton:hover {
    background-color: #E60073;
    transform: scale(1.05);
}


/* 🔹 Texte &quot;Remember Me&quot; et &quot;Forgot Password&quot; */
QCheckBox {
    color: white;
    font-size: 12pt;
}

QLabel#forgotPassword {
    color: rgba(255, 255, 255, 0.6);
    font-size: 12pt;
}
QLabel#forgotPassword:hover {
    color: white;
}
QLabel#userIcon {
    qproperty-alignment: AlignCenter;
    background-color: transparent;
    border-radius: 50px;
    padding: 10px;
}
</string>
        </property>
